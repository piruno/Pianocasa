rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signed(){ return request.auth != null; }
 function member(hid){ return signed() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)); }
 match /users/{uid} { allow read,write: if signed() && request.auth.uid==uid; }
 match /households/{hid} { allow create: if signed(); allow read,update: if member(hid);
   match /members/{uid} { allow read: if member(hid); allow create: if signed() && request.auth.uid==uid; allow update: if member(hid); }
   match /{document=**} { allow read,write: if member(hid); }
 }
 match /invites/{code} {
   allow create: if signed() && member(request.resource.data.householdId);
   allow read: if signed();
   allow update: if signed() && resource.data.claimedBy == null && request.resource.data.claimedBy == request.auth.uid && request.resource.data.householdId == resource.data.householdId;
   allow delete: if false;
 }
} }